{
  "name": "coentrify",
  "private": true,
  "type": "module",
  "license": "MIT-0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start:wiki": "vitepress dev",
    "build:wiki": "vitepress build",
    "lint:standards": "node scripts/lint-standards.mjs",
    "lint:commit-message": "node scripts/lint-commit-message.mjs",
    "changelog:standards": "node scripts/changelog-standards.mjs",
    "check:specifics": "node scripts/check-specifics.mjs",
    "hooks:pre-commit": "npm run lint:standards -- --staged",
    "hooks:commit-msg": "npm run lint:commit-message --",
    "ci:wiki": "npm run build:wiki",
    "tag:version": "node scripts/tag-version.mjs",
    "publish:npm": "node scripts/publish-npm.mjs",
    "ci:tag": "npm run tag:version --",
    "ci:publish": "npm run publish:npm"
  },
  "devDependencies": {
    "vitepress": "1.6.4"
  }
}
